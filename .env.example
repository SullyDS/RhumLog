# RhumLog runtime mode:
# - auto  : demo if no private owner id is configured, owner/private otherwise
# - demo  : force the bundled anonymized read-only portfolio snapshot
# - owner : force the private SQLite dataset
RHUMLOG_APP_MODE=auto

# Private / persistent SQLite path (ignored by demo mode)
RHUMLOG_DATABASE_PATH=data/rhumlog.sqlite

# Historical owner identifier for the private dataset.
# Leave empty in the public repo / public demo deployment.
RHUMLOG_SOURCE_OWNER_ID=

# Email allowed to write when OIDC is configured.
RHUMLOG_OWNER_EMAIL=

# Local development only. NEVER set to 1 in production.
# This flag is ignored when RHUMLOG_APP_MODE=demo.
RHUMLOG_DEV_OWNER=0
